<?xml version="1.0" encoding="utf-8"?>
<!--
  TobinMUD Client MSI installer manifest, built via msitools wixl
  (TobinMUD Client project, Phase 1c, 2026-08-05). Silent install is
  standard MSI behavior, not anything defined here: once this
  produces a real .msi, msiexec /i TobinMUDClient.msi /quiet (or
  /qn for no UI at all) just works, per the MSI format itself. See
  client/README.md for the build command and install instructions.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="TobinMUD Client"
           Language="1033"
           Version="0.1.0.0"
           Manufacturer="The TobinMUD Team"
           UpgradeCode="6f2a6f6e-9b1a-4b8a-8b0a-1f0b6a2c7e11">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of TobinMUD Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="TobinMUD Client" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppProgramMenuFolder" Name="TobinMUD Client" />
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="8c2e4b0a-2b3f-4d3e-9b7a-2f6b0a1c9d22">
        <File Id="TobinMUDClientEXE" Source="TobinMUDClient.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="1a9d3e5c-7b2a-4f0e-8a1d-3c6e9b2f0a44">
        <Shortcut Id="TobinMUDClientStartMenu"
                  Name="TobinMUD Client"
                  Target="[INSTALLFOLDER]TobinMUDClient.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                        Key="Software\TobinMUD\Client"
                        Name="installed"
                        Type="integer"
                        Value="1"
                        KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="TobinMUD Client" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Product>
</Wix>
