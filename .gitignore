# Anchored to the repo root -- a bare `core`/`core.*` (unanchored) would also
# match c_port/src/core/, silently excluding that entire source directory
# from version control. Found this the hard way: gametime.c and zone.c had
# never actually been committed despite being pushed as part of "everything"
# earlier this session.
/core
/core.*

# Game log files (logs/<datetime>.game.log) -- never commit server logs
c_port/logs/
logs/

# Packaging artifacts
tobin_takehome.zip

# Upstream SneezyMUD reference clone -- re-clone per location; not part of
# tobin-mud, and far too large to commit.
sneezymud-master/

# Upstream tbaMUD reference clone -- same rationale as sneezymud-master/.
tbamud-master/

# Upstream SneezyMUD "peel" reference clone (more complete source tree than
# sneezymud-master/, e.g. has the real planting system) -- same rationale.
peel-sneezymud/
sneezymud-peel/

# Loose class-reference scratch notes dumped at the repo root.
*skills.txt

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
compile_commands.json

# Per-box secrets sourced by watchdog.sh/manual restarts (TOBIN_WIPE_PASSWORD
# and friends) -- never committed, set once on each box that runs the server.
c_port/.env.local

# Claude Code local state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS cruft
.DS_Store
Thumbs.db
